{
  "name": "century-ai-training",
  "private": true,
  "version": "4.0.0",
  "description": "Century AI 4.0 自动进化训练系统（与 web-v1 共用同一 AI 决策核心编译产物）",
  "type": "module",
  "scripts": {
    "pretest": "node ../web-v1/scripts/sync-cards.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "simulate": "node simulator/cli.mjs",
    "challenge": "node tournament/challenge-cli.mjs",
    "evolve": "node optimizer/evolve-cli.mjs",
    "diagnose": "node diagnostics/analyze.mjs",
    "perf": "node evaluator/benchmark.mjs",
    "readiness:full": "node readiness/run-readiness.mjs",
    "determinism": "node scripts/verify-determinism.mjs",
    "fault:inject": "node scripts/fault-injection.mjs",
    "stats:plan": "node scripts/statistical-plan.mjs --check",
    "stats:plan:write": "node scripts/statistical-plan.mjs --write",
    "rollback:drill": "node scripts/rollback-drill.mjs",
    "autonomy:start": "node evolution/autonomous-run.mjs start",
    "autonomy:resume": "node evolution/autonomous-run.mjs resume",
    "autonomy:stop": "node evolution/autonomous-run.mjs stop",
    "autonomy:status": "node evolution/autonomous-run.mjs status",
    "coevolve:start": "node evolution/autonomous-run.mjs start --coevolve",
    "coevolve:resume": "node evolution/autonomous-run.mjs resume --coevolve",
    "coevolve:status": "node evolution/autonomous-run.mjs status --coevolve",
    "ai9:openevolve": "node evolution/run-ai9-openevolve.mjs",
    "ai9:interaction": "node scripts/ai9-interaction-experiment.mjs",
    "ai9:all-modules-game": "node scripts/ai9-all-modules-game.mjs",
    "ai9:module-matrix": "node scripts/ai9-module-matrix.mjs",
    "ai9:resource": "node scripts/ai9-resource-report.mjs",
    "ai9:deploy-drill": "node scripts/module-deploy-drill.mjs",
    "module:apply": "node scripts/apply-modules.mjs",
    "baseline": "node baseline/cli.mjs",
    "baseline:perf": "node baseline/perf.mjs",
    "baseline:freeze": "node baseline/freeze.mjs",
    "baseline:freeze-check": "node baseline/freeze.mjs --check",
    "gate": "node redteam/audit-gate.mjs --tier dev",
    "governance": "node scripts/seed-governance-cli.mjs status",
    "governance:check": "node scripts/seed-governance-cli.mjs check",
    "gate:research": "node redteam/audit-gate.mjs --tier research",
    "gate:promotion": "node redteam/audit-gate.mjs --tier promotion",
    "redteam": "node --test --test-concurrency=2 redteam/tests/redteam.test.mjs",
    "scenarios": "node --test --test-concurrency=2 scenarios/tests/*.test.mjs",
    "scenarios:generate": "node scenarios/scripts/generate.mjs",
    "scenarios:compare": "node scenarios/scripts/compare-budgets.mjs",
    "scenarios:split": "node scenarios/scripts/split-dataset.mjs",
    "evolution:test": "node --test evolution/tests/*.test.mjs",
    "evolution:demo": "node evolution/demo.mjs",
    "evolution:demo:fake": "node evolution/demo.mjs --fake",
    "ai9:wiring": "node scripts/ai9-module-wiring-audit.mjs",
    "ai9:execution": "node scripts/ai9-module-execution-audit.mjs",
    "ai9:crossover": "node scripts/ai9-crossover-game.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
