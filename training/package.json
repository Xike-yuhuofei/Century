{
  "name": "century-ai-training",
  "private": true,
  "version": "4.0.0",
  "description": "Century AI 4.0 自动进化训练系统（与 web-v1 共用同一 AI 决策核心编译产物）",
  "type": "module",
  "scripts": {
    "pretest": "node ../web-v1/scripts/sync-cards.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "simulate": "node simulator/cli.mjs",
    "challenge": "node tournament/challenge-cli.mjs",
    "evolve": "node optimizer/evolve-cli.mjs",
    "diagnose": "node diagnostics/analyze.mjs",
    "perf": "node evaluator/benchmark.mjs",
    "baseline": "node baseline/cli.mjs",
    "baseline:perf": "node baseline/perf.mjs",
    "baseline:freeze": "node baseline/freeze.mjs",
    "baseline:freeze-check": "node baseline/freeze.mjs --check",
    "scenarios": "node --test --test-concurrency=2 scenarios/tests/*.test.mjs",
    "scenarios:generate": "node scenarios/scripts/generate.mjs",
    "scenarios:compare": "node scenarios/scripts/compare-budgets.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
